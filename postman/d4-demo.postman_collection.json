{
  "info": {
    "name": "Tutor Matcher D4 demo (API gateway)",
    "description": "Requests go through the API gateway. Log in, then paste the token into this collection's Authorization tab (Bearer Token) and save. Notification events appear in `docker compose logs -f notification-service`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "tutorId",
      "value": ""
    },
    {
      "key": "slot1",
      "value": ""
    },
    {
      "key": "slot2",
      "value": ""
    },
    {
      "key": "topupId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Get wallet",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/wallet"
      }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student.{{$timestamp}}@example.com\",\n  \"password\": \"password123\",\n  \"displayName\": \"Demo Student\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code < 300) pm.collectionVariables.set('email', pm.response.json().user.email);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"password123\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Create tutor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tutors",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\",\n  \"email\": \"ada.{{$timestamp}}@example.com\",\n  \"bio\": \"Math tutor\",\n  \"status\": \"PUBLISHED\",\n  \"subjects\": [\n    {\n      \"name\": \"Mathematics\",\n      \"description\": \"Algebra\",\n      \"hourlyRate\": 400\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code < 300) pm.collectionVariables.set('tutorId', pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Open slot 09:00",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/availability",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tutorId\": \"{{tutorId}}\",\n  \"startedAt\": \"2026-11-20T09:00:00.000Z\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code < 300) pm.collectionVariables.set('slot1', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Open slot 09:30",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/availability",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tutorId\": \"{{tutorId}}\",\n  \"startedAt\": \"2026-11-20T09:30:00.000Z\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code < 300) pm.collectionVariables.set('slot2', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Top up",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/wallet/topups",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 500\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code < 300) pm.collectionVariables.set('topupId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirm top-up (simulate PromptPay)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/wallet/topups/{{topupId}}/confirm"
      }
    },
    {
      "name": "Search tutors",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tutors?subject=Mathematics",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Get tutor profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tutors/{{tutorId}}",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Create booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tutorId\": \"{{tutorId}}\",\n  \"subjectName\": \"Mathematics\",\n  \"slotIds\": [\n    \"{{slot1}}\",\n    \"{{slot2}}\"\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code < 300) pm.collectionVariables.set('bookingId', pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Pay booking",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/bookings/{{bookingId}}/pay"
      }
    },
    {
      "name": "Cancel booking",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/bookings/{{bookingId}}/cancel"
      }
    }
  ]
}
