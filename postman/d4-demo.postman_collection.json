{
  "info": {
    "name": "Tutor Matcher D4 demo (API gateway)",
    "description": "Run in order against the API gateway. Notification events appear in `docker compose logs -f notification-service`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tutorId",
      "value": ""
    },
    {
      "key": "slot1",
      "value": ""
    },
    {
      "key": "slot2",
      "value": ""
    },
    {
      "key": "topupId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Register student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student.{{$timestamp}}@example.com\",\n  \"password\": \"password123\",\n  \"displayName\": \"Demo Student\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Registered', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('email', pm.response.json().user.email);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"password123\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Logged in', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Wallet without token (401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/wallet",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Rejected without token', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Create tutor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tutors",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\",\n  \"email\": \"ada.{{$timestamp}}@example.com\",\n  \"bio\": \"Math tutor\",\n  \"status\": \"PUBLISHED\",\n  \"subjects\": [\n    {\n      \"name\": \"Mathematics\",\n      \"description\": \"Algebra\",\n      \"hourlyRate\": 400\n    }\n  ]\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Created tutor', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('tutorId', pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Open slot 09:00",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/availability",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tutorId\": \"{{tutorId}}\",\n  \"startedAt\": \"2026-11-20T09:00:00.000Z\"\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('slot1', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Open slot 09:30",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/availability",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tutorId\": \"{{tutorId}}\",\n  \"startedAt\": \"2026-11-20T09:30:00.000Z\"\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('slot2', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "7. UC-04 Top up 500",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/wallet/topups",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 500\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Top-up pending', () => pm.expect(pm.response.json().status).to.eql('PENDING'));",
              "pm.collectionVariables.set('topupId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "8. UC-04 Simulate PromptPay payment",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/wallet/topups/{{topupId}}/confirm",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Paid', () => pm.expect(pm.response.json().status).to.eql('PAID'));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. UC-04 Confirm again (no double credit)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/wallet/topups/{{topupId}}/confirm",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Already confirmed', () => pm.expect(pm.response.json().alreadyConfirmed).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Wallet balance",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/wallet",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "11. UC-03 Search tutors",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tutors?subject=Mathematics",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "12. UC-03 Tutor profile with slots",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tutors/{{tutorId}}",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "13. UC-03 Book 1 hour",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tutorId\": \"{{tutorId}}\",\n  \"subjectName\": \"Mathematics\",\n  \"slotIds\": [\n    \"{{slot1}}\",\n    \"{{slot2}}\"\n  ]\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Payment due', () => pm.expect(pm.response.json().status).to.eql('PAYMENT_DUE'));",
              "pm.collectionVariables.set('bookingId', pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "14. UC-03 Pay from wallet",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/bookings/{{bookingId}}/pay",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Confirmed', () => pm.expect(pm.response.json().status).to.eql('CONFIRMED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "15. Wallet after payment",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/wallet",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "16. UC-06 Cancel booking",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/bookings/{{bookingId}}/cancel",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Cancelled', () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "17. Wallet after refund",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/wallet",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
}
