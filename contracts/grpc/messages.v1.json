{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gRPC request/availability validation views v1",
  "$defs": {
    "LookupAccountsRequest": {
      "type": "object",
      "properties": {
        "userIds": {
          "type": "array",
          "items": {
            "$ref": "../schemas/v1.json#/$defs/Id"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "userIds"
      ],
      "additionalProperties": false
    },
    "ListActiveAdminsRequest": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "GrantTutorCapabilityRequest": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "../schemas/v1.json#/$defs/Id"
        },
        "command": {
          "$ref": "../schemas/v1.json#/$defs/CapabilityGrant"
        }
      },
      "required": [
        "operationId",
        "command"
      ],
      "additionalProperties": false
    },
    "GetTutorGrantRequest": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "../schemas/v1.json#/$defs/Id"
        }
      },
      "required": [
        "operationId"
      ],
      "additionalProperties": false
    },
    "GetResetNotificationContentRequest": {
      "type": "object",
      "properties": {
        "contentRef": {
          "$ref": "../schemas/v1.json#/$defs/Id"
        }
      },
      "required": [
        "contentRef"
      ],
      "additionalProperties": false
    },
    "GetTutorEligibilityRequest": {
      "type": "object",
      "properties": {
        "userId": {
          "$ref": "../schemas/v1.json#/$defs/Id"
        }
      },
      "required": [
