PORT=4003
GRPC_PORT=50054
# Course deployment only: enables the simulated provider controls.
DEMO_MODE=true
DATABASE_URL=postgresql://wallet_owner:change-me@postgres:5432/wallet_db
# Producer broker user `wallet`. Notification's queue topology must already exist.
RABBITMQ_URL=amqp://wallet:change-me@rabbitmq:5672
# RS256 public key of Auth's actor assertion (PEM, \n-escaped on one line).
ACTOR_ASSERTION_PUBLIC_KEY=
# Inbound credentials (>= 16 chars): Traefik presents the gateway one, Booking its own over gRPC.
GATEWAY_WORKLOAD_CREDENTIAL=
BOOKING_WORKLOAD_CREDENTIAL=
# Credential Wallet presents to Auth, Booking and Tutor over gRPC.
WALLET_WORKLOAD_CREDENTIAL=
# >= 32 characters. Never log it; rotating it changes payout duplicate detection.
PAYOUT_FINGERPRINT_KEY=
AUTH_GRPC_URL=auth-service:50051
BOOKING_GRPC_URL=booking-service:50052
TUTOR_GRPC_URL=tutor-service:50053
# Any secret above may be supplied as <NAME>_FILE=/run/secrets/<file> instead (never both).
