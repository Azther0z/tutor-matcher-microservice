PORT=4007
# MongoDB must run as a (single-member) replica set: acceptance uses multi-document transactions.
MONGO_URI=mongodb://notification_owner:change-me@mongo:27017/notification_db?authSource=notification_db&replicaSet=rs0
MONGO_DB=notification_db
# Consumer broker user `notification`.
RABBITMQ_URL=amqp://notification:change-me@rabbitmq:5672
# RS256 public key of Auth's actor assertion (PEM, \n-escaped on one line).
ACTOR_ASSERTION_PUBLIC_KEY=
# Credential Traefik presents to Notification (>= 16 chars).
GATEWAY_WORKLOAD_CREDENTIAL=
# Credential Notification presents to Auth and Booking over gRPC.
NOTIFICATION_WORKLOAD_CREDENTIAL=
AUTH_GRPC_URL=auth-service:50051
BOOKING_GRPC_URL=booking-service:50052
# Optional. Default maps each broker user to the producer of the same name.
# PUBLISHER_IDENTITIES={"auth":"auth","tutor":"tutor","booking":"booking","wallet":"wallet","review":"review","messaging":"messaging"}
# Any secret above may be supplied as <NAME>_FILE=/run/secrets/<file> instead (never both).
