PORT=4007
# MongoDB must run as a (single-member) replica set: acceptance uses multi-document transactions.
MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0
MONGO_DB=notification_db
RABBITMQ_URL=amqp://notification:change-me@rabbitmq:5672
CONSUL_URL=http://consul:8500
# RS256 public key of the Gateway actor assertion (PEM, \n-escaped on one line).
GATEWAY_PUBLIC_KEY=
# JSON map caller -> opaque credential (>= 16 chars). Notification expects "gateway".
WORKLOAD_CREDENTIALS={"gateway":""}
# Credential this service presents to Auth and Booking over gRPC.
NOTIFICATION_WORKLOAD_CREDENTIAL=
AUTH_GRPC_URL=auth-service:50051
BOOKING_GRPC_URL=booking-service:50052
# Optional. Default maps each broker user to the producer of the same name.
# PUBLISHER_IDENTITIES={"auth":"auth","tutor":"tutor","booking":"booking","wallet":"wallet","review":"review","messaging":"messaging"}
